# TMDB API Key — get yours at https://www.themoviedb.org/settings/api
# MUST be server-side only. Never prefix with NEXT_PUBLIC_
TMDB_API_KEY=your_tmdb_api_key_here

# Self-hosted Consumet instance (optional) — anime playback only.
# Root URL of your own deployment, e.g. https://consumet.your-domain.com
# Leave empty to keep anime playback in the honest "Playback unavailable" state.
# VEYRA never falls back to a public Consumet instance.
CONSUMET_BASE_URL=

# Optional operator-hosted anime provider adapters. Empty values are skipped.
REANIME_BASE_URL=
ANIGO_BASE_URL=
ANIME_PROVIDER_TIMEOUT_MS=10000
ANIME_PARALLEL_FETCH=true
# Anime scraping providers may carry legal risk. Enable only providers you operate
# or are authorized to use, and understand the legal implications first.

# Supabase public browser/server configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

# Telegram webhook and private admin access
TELEGRAM_BOT_TOKEN=bot_token
TELEGRAM_WEBHOOK_SECRET=random_webhook_secret
TELEGRAM_ADMIN_CHAT_IDS=123456789

# GitHub issue creation
GITHUB_TOKEN=server_only_github_token
GITHUB_REPOSITORY=owner/repository

# Free-first AI providers; omit any provider you do not use
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=

# Central model overrides (OpenRouter must remain openrouter/free or end in :free in zero-cost mode)
GEMINI_MODEL=gemini-2.0-flash-lite
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=openrouter/free

# Router safety and bounded latency
AI_ZERO_COST_ONLY=true
ALLOW_PAID_AI=false
AI_PROVIDER_ORDER=groq,gemini,cloudflare,mistral,openrouter,cohere,huggingface,cerebras,nvidia
AI_PROVIDER_TIMEOUT_MS=10000
AI_SYNC_BUDGET_MS=25000
AI_PROVIDER_COOLDOWN_MS=60000
