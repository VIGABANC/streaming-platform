# TMDB API Key — get yours at https://www.themoviedb.org/settings/api
# MUST be server-side only. Never prefix with NEXT_PUBLIC_
TMDB_API_KEY=your_tmdb_api_key_here

# Supabase public browser/server configuration.
# Use the publishable key for new projects; the anon key is supported for compatibility.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# External embed provider base URL
# The player will call:  {provider}/embed/movie/{tmdb_id}/
#                        {provider}/embed/tv/{tmdb_id}/{season}/{episode}/
NEXT_PUBLIC_EMBED_PROVIDER=https://v1.vidsrc.wiki
