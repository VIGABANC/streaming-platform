# TMDB API Key — get yours at https://www.themoviedb.org/settings/api
# ⚠️  MUST be server-side only. Never prefix with NEXT_PUBLIC_
TMDB_API_KEY=

# External embed provider base URL
# The player will call:  {provider}/embed/movie/{tmdb_id}/
#                        {provider}/embed/tv/{tmdb_id}/{season}/{episode}/
NEXT_PUBLIC_EMBED_PROVIDER=https://v1.vidsrc.wiki
